# Reproducible env-var config for this EB environment, so it doesn't only live in the
# console. Replace every __PLACEHOLDER__ before `eb deploy` — see AWS_DEPLOY.md.
option_settings:
  aws:elasticbeanstalk:application:environment:
    POSTGRES_HOST: "__INFRA_BOX_PRIVATE_IP__"
    POSTGRES_USER: "bookinguser"
    POSTGRES_PASSWORD: "__POSTGRES_BOOKING_SERVICE_PASSWORD__"
    KAFKA_BOOTSTRAP_SERVERS: "__INFRA_BOX_PRIVATE_IP__:9092"
    COUCHBASE_CONNECTION_STRING: "couchbase://__INFRA_BOX_PRIVATE_IP__"
    COUCHBASE_USERNAME: "Administrator"
    COUCHBASE_PASSWORD: "__COUCHBASE_PASSWORD__"
    MINIO_ENDPOINT: "http://__INFRA_BOX_PRIVATE_IP__:9000"
    MINIO_ACCESS_KEY: "__MINIO_ACCESS_KEY__"
    MINIO_SECRET_KEY: "__MINIO_SECRET_KEY__"
    WIREMOCK_BASE_URL: "http://__INFRA_BOX_PRIVATE_IP__:9090"
    TOY_SERVICE_URL: "http://__TOY_SERVICE_EB_URL__"
    ADMIN_USERNAME: "admin"
    ADMIN_PASSWORD: "__ADMIN_PASSWORD__"
    ZIPKIN_ENDPOINT: "http://__INFRA_BOX_PRIVATE_IP__:9411/api/v2/spans"
    ALLOWED_CORS_ORIGINS: "https://__CLOUDFRONT_DOMAIN__"
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /actuator/health
