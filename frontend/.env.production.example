# Copy to .env.production (Vite loads this automatically for `npm run build`) and fill
# in the real EB environment URLs once they exist — see AWS_DEPLOY.md. Same two vars
# frontend/src/lib/api.ts already reads for local dev (see .env.example); this is just
# the AWS deployment's equivalent, not a code change.
VITE_TOY_SERVICE_URL=http://__TOY_SERVICE_EB_URL__
VITE_BOOKING_SERVICE_URL=http://__BOOKING_SERVICE_EB_URL__
