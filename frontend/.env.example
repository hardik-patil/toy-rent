# api-gateway stays out of scope (its Keycloak-based JWT validation was never wired up —
# see CLAUDE.md's Known Bugs / environment variables reference), so the frontend talks to
# toy-service and booking-service directly, same as this whole session's own testing pattern
# (kubectl port-forward svc/toy-service 8081:8081, svc/booking-service 8082:8082).
VITE_TOY_SERVICE_URL=http://localhost:8081
VITE_BOOKING_SERVICE_URL=http://localhost:8082
