# Reproducible env-var config for this EB environment, so it doesn't only live in the
# console. Replace every __PLACEHOLDER__ before `eb deploy` — see AWS_DEPLOY.md.
#
# NOTE: api-gateway's JWT validation against Keycloak was never wired up (see
# STARTUP.md / CLAUDE.md's Known Bugs table) — the frontend bypasses it and calls
# toy-service/booking-service directly, same as local dev. Deploying this environment
# does not fix that pre-existing gap; it's included only for architectural parity with
# the other two services.
option_settings:
  aws:elasticbeanstalk:application:environment:
    REDIS_HOST: "__INFRA_BOX_PRIVATE_IP__"
    REDIS_PORT: "6379"
    TOY_SERVICE_URL: "http://__TOY_SERVICE_EB_URL__"
    BOOKING_SERVICE_URL: "http://__BOOKING_SERVICE_EB_URL__"
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /actuator/health
