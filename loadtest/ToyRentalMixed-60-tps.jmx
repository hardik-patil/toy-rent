            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/v1/bookings" enabled="true">
              <stringProp name="HTTPSampler.port">${BOOKING_PORT}</stringProp>
              <stringProp name="HTTPSampler.path">/api/v1/bookings</stringProp>
