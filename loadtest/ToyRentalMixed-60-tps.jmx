<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ToyRentalMixed">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(HOST,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TOY_PORT" elementType="Argument">
            <stringProp name="Argument.name">TOY_PORT</stringProp>
            <stringProp name="Argument.value">${__P(TOY_PORT,8081)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BOOKING_PORT" elementType="Argument">
            <stringProp name="Argument.name">BOOKING_PORT</stringProp>
            <stringProp name="Argument.value">${__P(BOOKING_PORT,8082)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THREADS" elementType="Argument">
            <stringProp name="Argument.name">THREADS</stringProp>
            <stringProp name="Argument.value">${__P(THREADS,150)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CUST_PHONE" elementType="Argument">
            <stringProp name="Argument.name">CUST_PHONE</stringProp>
            <stringProp name="Argument.value">${__P(CUST_PHONE,9821012345)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CUST_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">CUST_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(CUST_PASSWORD,password)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP_UP" elementType="Argument">
            <stringProp name="Argument.name">RAMP_UP</stringProp>
            <stringProp name="Argument.value">${__P(RAMP_UP,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TEST_DURATION" elementType="Argument">
            <stringProp name="Argument.name">TEST_DURATION</stringProp>
            <stringProp name="Argument.value">${__P(TEST_DURATION,300)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TPS" elementType="Argument">
            <stringProp name="Argument.name">TPS</stringProp>
            <stringProp name="Argument.value">${__P(TPS,60)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THROUGHPUT_PER_HOUR" elementType="Argument">
            <stringProp name="Argument.name">THROUGHPUT_PER_HOUR</stringProp>
            <!-- Reads the TPS *property* directly via __P, not the TPS UDV via ${TPS} -
                 chaining ${TPS} here depended on the TPS Argument having already been
                 resolved into the variables map earlier in this same UDV batch, which is
                 not guaranteed. It silently resolved to empty/0 at runtime, which is why
                 the timer logged "rate 0.0" and then threw BufferUnderflowException on
                 every sampler in its scope. -->
            <stringProp name="Argument.value">${__groovy(${__P(TPS,60)}*3600,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <intProp name="HTTPSampler.connect_timeout">5000</intProp>
