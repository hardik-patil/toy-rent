            <hashTree/>
          </hashTree>
        </hashTree>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="While Controller" enabled="true">
          <stringProp name="WhileController.condition">${__groovy(System.currentTimeMillis() - Long.parseLong(vars.get(&quot;tokenTimeStamp&quot;)) &gt;= 900000,)}</stringProp>
        </WhileController>
