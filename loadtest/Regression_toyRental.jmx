<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Test Plan">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(HOST,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TOY_PORT" elementType="Argument">
            <stringProp name="Argument.name">TOY_PORT</stringProp>
            <stringProp name="Argument.value">${__P(TOY_PORT,8081)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BOOKING_PORT" elementType="Argument">
            <stringProp name="Argument.name">BOOKING_PORT</stringProp>
            <stringProp name="Argument.value">${__P(BOOKING_PORT,8082)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="path_toys" elementType="Argument">
            <stringProp name="Argument.name">path_toys</stringProp>
            <stringProp name="Argument.value">/api/v1/toys</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="path_bookings" elementType="Argument">
            <stringProp name="Argument.name">path_bookings</stringProp>
            <stringProp name="Argument.value">/api/v1/bookings</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="path_login" elementType="Argument">
            <stringProp name="Argument.name">path_login</stringProp>
            <stringProp name="Argument.value">/api/v1/customers/login</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="THREADS" elementType="Argument">
            <stringProp name="Argument.name">THREADS</stringProp>
            <stringProp name="Argument.value">${__P(THREADS,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP_UP" elementType="Argument">
            <stringProp name="Argument.name">RAMP_UP</stringProp>
            <stringProp name="Argument.value">${__P(RAMP_UP,10)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TEST_DURATION" elementType="Argument">
            <stringProp name="Argument.name">TEST_DURATION</stringProp>
            <stringProp name="Argument.value">${__P(TEST_DURATION,900)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="p_transactions_per_min" elementType="Argument">
            <stringProp name="Argument.name">p_transactions_per_min</stringProp>
            <stringProp name="Argument.value">${__groovy(${__P(TPS,60)}*60,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CUST_PHONE" elementType="Argument">
            <stringProp name="Argument.name">CUST_PHONE</stringProp>
            <stringProp name="Argument.value">${__P(CUST_PHONE,9821012345)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CUST_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">CUST_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(CUST_PASSWORD,password)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
